---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { whatsappHref, site } from '@/data/site';

interface Props {
  title: string;
  alt: string;
  image: ImageMetadata;
}

const { title, alt, image } = Astro.props;
---

<a
  href={whatsappHref(`Hola! Me interesa encargar una torta como "${title}" en ${site.name}`)}
  target="_blank"
  rel="noopener noreferrer"
  class="group block overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-cocoa/5 transition hover:shadow-md"
>
  <div class="aspect-square overflow-hidden">
    <Image
      src={image}
      alt={alt}
      class="size-full object-cover transition duration-300 group-hover:scale-105"
      widths={[300, 600]}
      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
    />
  </div>
  <p class="px-3 py-2 text-sm font-medium text-cocoa">{title}</p>
</a>
