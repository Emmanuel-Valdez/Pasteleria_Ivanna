---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { whatsappHref, site } from '@/data/site';

interface Props {
  title: string;
  alt: string;
  image: ImageMetadata;
}

const { title, alt, image } = Astro.props;
const full = await getImage({ src: image, width: 1080, format: 'webp' });
---

<button
  type="button"
  data-lightbox
  data-full={full.src}
  data-title={title}
  data-alt={alt}
  data-wa={whatsappHref(`Hola! Me interesa encargar una torta como "${title}" en ${site.name}`)}
  aria-haspopup="dialog"
  class="group relative block w-full cursor-zoom-in overflow-hidden rounded-2xl shadow-sm ring-1 ring-cocoa/5 transition hover:shadow-lg"
>
  <div class="aspect-square overflow-hidden">
    <Image
      src={image}
      alt={alt}
      class="size-full object-cover transition duration-500 group-hover:scale-105"
      widths={[300, 600]}
      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
    />
  </div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-cocoa/80 to-transparent px-3 pb-2.5 pt-10 text-left">
    <p class="text-sm font-medium text-white drop-shadow-sm">{title}</p>
  </div>
</button>
