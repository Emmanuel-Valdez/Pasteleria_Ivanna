---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BentoTile from '@/components/BentoTile.astro';
import CakeCard from '@/components/CakeCard.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import WhatsAppIcon from '@/icons/WhatsAppIcon.astro';
import { site } from '@/data/site';
import alfajoresImg from '@/assets/alfajores.png';
import tartasImg from '@/assets/tartas.png';
import lemonpieImg from '@/assets/lemonpie.png';

const cakes = (await getCollection('cakes')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<section class="mx-auto max-w-5xl px-4">
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    <BentoTile
      title="Tortas"
      href="#tortas"
      class="col-span-2 aspect-[4/3] sm:row-span-2 sm:aspect-auto"
      image={cakes[0].data.image}
      imageHover={cakes[1]?.data.image}
    />
    <BentoTile href="#tortas" ariaLabel="Ver más tortas" class="aspect-square" image={cakes[2]?.data.image} />
    <BentoTile href="#tortas" ariaLabel="Ver más tortas" class="aspect-square" image={cakes[3]?.data.image} />
    <BentoTile title="Alfajores" href="#alfajores" image={alfajoresImg} class="aspect-square" />
    <BentoTile title="Tartas" href="#tartas" image={tartasImg} class="aspect-square" />
  </div>
</section>

<section id="tortas" class="mx-auto max-w-5xl scroll-mt-20 px-4 py-16">
  <h2 class="font-script text-3xl italic text-cocoa">Tortas</h2>
  <p class="mt-1 text-cocoa/70">Cumpleaños de 15, 18 o lo que estés festejando — la torta se arma como la imagines.</p>
  <p class="mt-1 text-sm text-cocoa/50">Tocá una foto para verla más grande.</p>
  <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
    {cakes.map((cake) => (
      <CakeCard title={cake.data.title} alt={cake.data.alt} image={cake.data.image} imageHover={cake.data.imageHover} />
    ))}
  </div>
</section>

<section id="alfajores" class="mx-auto max-w-5xl scroll-mt-20 px-4 py-16">
  <div class="grid overflow-hidden rounded-3xl bg-gold/15 sm:grid-cols-2">
    <Image
      src={alfajoresImg}
      alt="Plato de alfajores de maicena"
      class="size-full max-h-64 object-cover sm:max-h-none"
      widths={[370, 740]}
      sizes="(min-width: 640px) 50vw, 100vw"
    />
    <div class="flex flex-col items-center justify-center p-8 text-center sm:p-12">
      <h2 class="font-script text-3xl italic text-cocoa">Alfajores de maicena</h2>
      <p class="mt-2 text-cocoa/70">Los que te piden que lleves cuando hay mate en el laburo.</p>
      <div class="mt-6">
        <WhatsAppButton message={`Hola! Quiero consultar por alfajores de maicena en ${site.name}`}>
          Pedir alfajores
        </WhatsAppButton>
      </div>
    </div>
  </div>
</section>

<section id="tartas" class="relative mx-auto max-w-5xl scroll-mt-20 overflow-hidden px-4 py-16">
  <Image
    src={lemonpieImg}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 size-full scale-125 object-cover opacity-40 blur-2xl"
    widths={[700]}
    sizes="100vw"
  />
  <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-cream/30 via-cream/70 to-cream" aria-hidden="true"></div>
  <div class="grid overflow-hidden rounded-3xl bg-rose/15 backdrop-blur-sm sm:grid-cols-2">
    <Image
      src={tartasImg}
      alt="Tarta de frutilla con crema"
      class="size-full max-h-64 object-cover sm:order-2 sm:max-h-none"
      widths={[600, 1000]}
      sizes="(min-width: 640px) 50vw, 100vw"
    />
    <div class="flex flex-col items-center justify-center p-8 text-center sm:order-1 sm:p-12">
      <h2 class="font-script text-3xl italic text-cocoa">Tartas</h2>
      <p class="mt-2 text-cocoa/70">Frutilla, naranja, cabsha, coco y dulce de leche, lemon pie, ricota y más.</p>
      <div class="mt-6">
        <WhatsAppButton message={`Hola! Quiero consultar por tartas en ${site.name}`}>
          Encargar tartas
        </WhatsAppButton>
      </div>
    </div>
  </div>
</section>

<dialog
  id="lightbox"
  aria-labelledby="lightbox-title"
  class="m-auto w-[min(92vw,38rem)] rounded-3xl bg-cream p-0 shadow-2xl backdrop:bg-cocoa/60 backdrop:backdrop-blur-sm"
>
  <div class="relative">
    <img id="lightbox-img" src="" alt="" class="max-h-[70vh] w-full rounded-t-3xl bg-white object-contain" />
    <button
      id="lightbox-close"
      type="button"
      aria-label="Cerrar"
      class="absolute right-3 top-3 grid size-9 place-items-center rounded-full bg-cocoa/60 text-white transition hover:bg-cocoa/80"
    >
      ✕
    </button>
    <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4">
      <p id="lightbox-title" class="font-script text-xl italic text-cocoa"></p>
      <a
        id="lightbox-wa"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-whatsapp px-5 py-2.5 text-sm font-semibold text-white shadow-md transition hover:brightness-105"
      >
        <WhatsAppIcon class="size-5" />
        Encargar una así
      </a>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const title = document.getElementById('lightbox-title')!;
  const wa = document.getElementById('lightbox-wa') as HTMLAnchorElement;

  for (const btn of document.querySelectorAll<HTMLElement>('[data-lightbox]')) {
    btn.addEventListener('click', () => {
      img.src = btn.dataset.full ?? '';
      img.alt = btn.dataset.alt ?? '';
      title.textContent = btn.dataset.title ?? '';
      wa.href = btn.dataset.wa ?? '#';
      dialog.showModal();
    });
  }

  // ponytail: click on the dialog element itself = backdrop (content is wrapped in a full-size div)
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  document.getElementById('lightbox-close')!.addEventListener('click', () => dialog.close());
</script>
