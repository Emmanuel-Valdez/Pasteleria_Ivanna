---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title?: string;
  ariaLabel?: string;
  class?: string;
  image: ImageMetadata;
  imageHover?: ImageMetadata;
}

const { href, title, ariaLabel, class: className, image, imageHover } = Astro.props;
---

<a
  href={href}
  aria-label={ariaLabel}
  class={`group relative block overflow-hidden rounded-3xl shadow-sm transition hover:shadow-md ${className ?? ''}`}
>
  <Image
    src={image}
    alt=""
    class={`absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105 ${imageHover ? 'group-hover:opacity-0' : ''}`}
    widths={[400, 800]}
    sizes="(min-width: 768px) 50vw, 100vw"
  />
  {imageHover && (
    <Image
      src={imageHover}
      alt=""
      class="absolute inset-0 size-full object-cover opacity-0 transition duration-500 group-hover:opacity-100 group-hover:scale-105"
      widths={[400, 800]}
      sizes="(min-width: 768px) 50vw, 100vw"
    />
  )}
  {title && (
    <>
      <div class="absolute inset-0 bg-gradient-to-t from-cocoa/70 via-cocoa/10 to-transparent" />
      <span class="absolute bottom-4 left-4 font-script text-2xl italic text-white drop-shadow-sm sm:text-3xl">
        {title}
      </span>
    </>
  )}
</a>
