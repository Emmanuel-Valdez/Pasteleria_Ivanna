---
import { Image } from 'astro:assets';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import { site } from '@/data/site';
import heroImg from '@/assets/cakes/torta_crunchy.png';
---

<section id="top" class="relative overflow-hidden px-4 pb-0 pt-14 text-center sm:text-left">
  <div class="pointer-events-none absolute -top-24 left-1/2 size-72 -translate-x-[110%] rounded-full bg-rose/25 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-16 left-1/2 size-72 translate-x-[15%] rounded-full bg-gold/20 blur-3xl" aria-hidden="true"></div>
  <svg class="pointer-events-none absolute -left-6 -top-6 size-28 text-rose/25" viewBox="0 0 100 100" fill="none" aria-hidden="true">
    <path d="M10 90 C 10 40, 40 10, 90 10" stroke="currentColor" stroke-width="2" />
    <path d="M20 90 C 20 50, 50 20, 90 20" stroke="currentColor" stroke-width="2" />
  </svg>
  <svg class="pointer-events-none absolute -right-6 -top-6 size-28 rotate-90 text-gold/25" viewBox="0 0 100 100" fill="none" aria-hidden="true">
    <path d="M10 90 C 10 40, 40 10, 90 10" stroke="currentColor" stroke-width="2" />
    <path d="M20 90 C 20 50, 50 20, 90 20" stroke="currentColor" stroke-width="2" />
  </svg>

  <div class="mx-auto grid max-w-5xl items-center gap-10 pb-16 sm:grid-cols-[1.1fr_0.9fr] sm:gap-6">
    <div>
      <p class="mb-4 inline-flex items-center gap-1.5 rounded-full border border-cocoa/10 bg-white/60 px-3.5 py-1 text-xs font-medium text-cocoa/80">
        <svg class="size-3.5 text-rose" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21Z" />
          <circle cx="12" cy="9.5" r="2.3" />
        </svg>
        Mendoza · Pedidos por encargo
      </p>
      <h1 class="font-script text-5xl italic text-cocoa sm:text-6xl">{site.name}</h1>
      <p class="mx-auto mt-3 max-w-md text-lg text-cocoa/70 sm:mx-0">{site.slogan}</p>
      <p class="mx-auto mt-1 max-w-md text-cocoa/70 sm:mx-0">
        Tortas personalizadas a pedido, alfajores de maicena y tartas — para cumpleaños, 15 años y cualquier celebración.
      </p>
      <div class="mt-8">
        <WhatsAppButton size="lg" message={`Hola! Quiero encargar una torta en ${site.name}`}>
          Encargá tu torta por WhatsApp
        </WhatsAppButton>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-xs sm:max-w-none">
      <div class="pointer-events-none absolute inset-4 -z-10 rotate-3 rounded-[2rem] bg-gold/20" aria-hidden="true"></div>
      <div class="-rotate-2 overflow-hidden rounded-[2rem] bg-white shadow-xl ring-1 ring-cocoa/5 transition duration-500 hover:rotate-0">
        <Image
          src={heroImg}
          alt="Torta de chocolate cubierta con perlas crocantes, chocolates y galletas Oreo, una de las creaciones de la pastelería"
          class="aspect-[4/5] w-full object-cover"
          widths={[400, 700]}
          sizes="(min-width: 640px) 40vw, 80vw"
        />
      </div>
    </div>
  </div>

  <div class="doily-edge" aria-hidden="true"></div>
</section>

<style>
  .doily-edge {
    height: 18px;
    background: color-mix(in srgb, #c9a227 35%, transparent);
    mask-image: radial-gradient(circle at 12px 0, transparent 11px, black 12px);
    mask-size: 24px 24px;
    mask-repeat: repeat-x;
    -webkit-mask-image: radial-gradient(circle at 12px 0, transparent 11px, black 12px);
    -webkit-mask-size: 24px 24px;
    -webkit-mask-repeat: repeat-x;
  }
</style>
